# Copy to .env for local development. .env is gitignored; this file is not, so
# it must never hold a real value — only defaults and placeholders.
#
# Loaded by dotenv-rails in development and test only. The deployed container
# gets its environment from Kamal (see .kamal/secrets and config/deploy.yml),
# never from a file in the image.

# Port Puma listens on. config/puma.rb reads it and falls back to 3000, so this
# is only needed when 3000 is taken.
#
# It is also the port the container publishes and the port kamal-proxy forwards
# to, both of which derive from this same value — see the PORT build argument in
# the Dockerfile and `app_port` in config/deploy.yml. Changing it in one place
# and not the others is the failure worth avoiding: the proxy would forward to a
# port nothing is listening on, and the only symptom would be a healthcheck that
# never turns green.
PORT=3000
