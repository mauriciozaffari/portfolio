# Agent session artifacts — local run state, not project content.
/.omo/
/local/
/.playwright-mcp/
/tmp/qa/

# The global ~/.gitignore excludes .opencode entirely. Re-include only the
# project skills, which AGENTS.md and features/TODO.md link to; everything else
# in there is local tooling and vendored dependencies.
!.opencode/
.opencode/*
!.opencode/skills/

# Document and key formats, ignored everywhere by shape rather than by path.
#
# This is the near-miss that already happened once: a resume carrying a phone
# number and a personal email sat in the working tree before the first commit.
# `data/` is protected structurally — the loader rejects any non-Markdown file
# and `content:scan` sweeps it — but the repository root and every other
# directory had no such guard, and the scanner does not walk them. Anything
# genuinely needed in one of these formats must be force-added deliberately.
*.pdf
!/downloads/mauricio-zaffari-resume.pdf
*.doc
*.docx
*.odt
*.pem
*.p12
*.pfx
*.ppk
id_rsa*

# Screenshots and QA captures. Browser tooling writes to the workspace root by
# default, so an artifact can land here between a review and a commit.
/*.png
/*.jpg
/*.jpeg
!/public/*.png

# Secrets. Nothing in this repository is private, so nothing here may be.
.env
.env.*
!.env.example
/config/master.key
/config/credentials/*.key

# .kamal/secrets is committed on purpose — it holds only $NAME references.
# These two variants are not, because they are the natural place to paste a
# literal value, and this repository is public.
/.kamal/secrets-common
/.kamal/secrets.*

# Curation scratch space. Private source material is reviewed outside this
# repository; if anything is ever staged locally, it must not be committable.
/tmp/curation/

# Rails runtime — takes effect once app-foundation lands.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/public/assets
/.bundle

# Compiled assets are build artifacts, rebuilt by `rails tailwindcss:build`.
# Committing them means reviewing a generated diff and shipping a stale one.
/app/assets/builds/*
!/app/assets/builds/.keep

# Tailwind CLI binary. Vendored by the tailwindcss-ruby gem, so this only
# catches a stray manual download.
/bin/tailwindcss

# OS and editor noise
.DS_Store
*.swp
*~

# Coverage reports are local test artifacts, never publication content.
/public/coverage
