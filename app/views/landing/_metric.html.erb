<%= tag.li class: "border-t border-rule py-6 first:border-t-0", **substitution_attributes(entry) do %>
  <p class="figure text-3xl font-bold lg:text-4xl"><%= entry.record[:value] %></p>
  <p class="label mt-3"><%= entry.record[:label] %></p>
  <p class="mt-2 max-w-measure text-lg text-ink-muted"><%= entry.record[:context] %></p>

  <%= render "substitution", entry: entry %>
<% end %>
