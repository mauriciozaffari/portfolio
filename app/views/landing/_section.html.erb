<%= tag.section id: id, aria: { labelledby: "#{id}-heading" }, **substitution_attributes(local_assigns[:entry]) do %>
  <div class="border-t border-rule-strong pt-8 lg:grid lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-3 lg:sticky lg:top-8 lg:self-start">
      <h2 id="<%= id %>-heading" class="label section-label"><%= label %></h2>
    </div>

    <div class="mt-8 lg:col-span-9 lg:mt-0">
      <%= yield %>
    </div>
  </div>
<% end %>
