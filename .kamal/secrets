# Secrets Kamal passes to the build and to the running container.
#
# This file is committed, and it is safe to commit, because every line is a
# reference rather than a value: Kamal resolves `$NAME` against the environment
# of the shell running the deploy. Nothing secret is written here.
#
# Do not inline a literal. This repository is public, so a value pasted below is
# published the moment it is pushed and has to be treated as compromised.
#
# Before the first deploy, in the shell you deploy from:
#
#   export KAMAL_REGISTRY_PASSWORD=...              # registry access token
#   export RAILS_MASTER_KEY=$(cat config/master.key)
#
# `config/master.key` is gitignored and never enters the image; the running
# container reads it from the environment, which is what this file arranges.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
