<p><%= t("pages.contact.intro", name: @metadata.profile[:name]) %></p>

<ul class="mt-6 middot-list text-xl">
  <% Array(@metadata.profile[:links]).each do |link| %>
    <li><%= link_to link[:label], link[:url], class: "link" %></li>
  <% end %>
</ul>

<p class="mt-8"><%= t("pages.contact.note") %></p>

<p class="mt-4">
  <%= link_to t("resume.concise"), authored_resume_path, class: "link" %>
</p>
<p class="mt-3">
  <%= link_to t("pages.contact.resume"), resume_path_for(@page.locale), class: "link" %>
</p>
