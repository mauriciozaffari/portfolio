# Agent session artifacts — local run state, not project content.
/.omo/

# The global ~/.gitignore excludes .opencode entirely. Re-include only the
# project skills, which AGENTS.md and features/TODO.md link to; everything else
# in there is local tooling and vendored dependencies.
!.opencode/
.opencode/*
!.opencode/skills/

# Secrets. Nothing in this repository is private, so nothing here may be.
.env
.env.*
!.env.example
/config/master.key
/config/credentials/*.key

# Curation scratch space. Private source material is reviewed outside this
# repository; if anything is ever staged locally, it must not be committable.
/tmp/curation/

# Rails runtime — takes effect once app-foundation lands.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/public/assets
/.bundle

# Compiled assets are build artifacts, rebuilt by `rails tailwindcss:build`.
# Committing them means reviewing a generated diff and shipping a stale one.
/app/assets/builds/*
!/app/assets/builds/.keep

# Tailwind CLI binary. Vendored by the tailwindcss-ruby gem, so this only
# catches a stray manual download.
/bin/tailwindcss

# OS and editor noise
.DS_Store
*.swp
*~
