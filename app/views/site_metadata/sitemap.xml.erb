<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% @sitemap.entries.each do |entry| %>
  <url>
    <loc><%= entry.url %></loc>
<% if entry.last_modified %>
    <lastmod><%= entry.last_modified.iso8601 %></lastmod>
<% end %>
<% SiteMetadata.alternates.each do |alternate| %>
    <xhtml:link rel="alternate" hreflang="<%= alternate[:hreflang] %>" href="<%= alternate[:href] %>"></xhtml:link>
<% end %>
  </url>
<% end %>
</urlset>
